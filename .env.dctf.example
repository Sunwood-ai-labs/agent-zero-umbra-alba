# Copy to .env.dctf for a persistent local deployment. Keep the copied file
# private; it is ignored by Git. Defaults in dctf/compose.yaml are local-only.
DCTF_BLACK_PORT=8400
DCTF_WHITE_PORT=8401
DCTF_BLACK_DB_ROOT_PASSWORD=replace-with-random-black-root
DCTF_BLACK_DB_PASSWORD=replace-with-random-black-db
DCTF_BLACK_SECRET_KEY=replace-with-random-black-secret
DCTF_WHITE_DB_ROOT_PASSWORD=replace-with-random-white-root
DCTF_WHITE_DB_PASSWORD=replace-with-random-white-db
DCTF_WHITE_SECRET_KEY=replace-with-random-white-secret
# Agent CTFd API tokens are generated locally (never commit them) with:
# .\scripts\provision-ctfd-agent-access.ps1 -Faction black
# .\scripts\provision-ctfd-agent-access.ps1 -Faction white
