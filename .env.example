# scripts/import-litellm-key.ps1 creates .env with random local secrets and
# securely imports LITELLM_MASTER_KEY from the running LiteLLM container.
# scripts/publish-tailscale.ps1 replaces MISSKEY_URL with this node's
# Tailnet-only HTTPS URL.
MISSKEY_PORT=3200
MISSKEY_URL=http://localhost:3200
MISSKEY_INTERNAL_URL=http://misskey:3000
POSTGRES_DB=misskey
POSTGRES_USER=misskey
POSTGRES_PASSWORD=replace-with-a-random-value
MISSKEY_SETUP_PASSWORD=replace-with-a-random-value
MISSKEY_ADMIN_USERNAME=admin
LITELLM_CONTAINER=open-webui-litellm
LITELLM_API_BASE=http://host.docker.internal:4000/v1
LITELLM_MODELS=glm-5.2,glm-4.7
LITELLM_MASTER_KEY=replace-with-the-existing-litellm-key
HERMES_API_SERVER_KEY=replace-with-a-random-internal-key
RANDOM_INTERVAL_MINUTES_MIN=2
RANDOM_INTERVAL_MINUTES_MAX=30
RANDOM_FAST_MAX_MINUTES=10
RANDOM_FAST_PROBABILITY=0.75
RANDOM_INITIAL_MAX_SECONDS=90
